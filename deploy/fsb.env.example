# Copy to /mnt/sda1/fsb/fsb.env (next to the binary) and fill in the required
# values. This file is git-ignored by design — never commit real credentials.

# ---- required ----
API_ID=
API_HASH=
BOT_TOKEN=
LOG_CHANNEL=

# Public URL the bot will put into the links it hands out.
# Use a domain when you have one; otherwise http://<lan-ip>:<port>.
HOST=
PORT=8080

# ---- optional: access control ----
# Comma separated Telegram user IDs allowed to use the bot. Empty = everyone.
# ALLOWED_USERS=123456789,987654321

# ---- optional: downloads ----
# Base directory for HLS output and everything handed to aria2.
# X/Twitter videos go to $DOWNLOAD_DIR/X.
DOWNLOAD_DIR=/mnt/sda1/fsb/downloads
# Set to false to skip aria2 entirely: m3u8 is still downloaded in-process,
# plain file links are just echoed back instead of queued.
ARIA2_ENABLE=true
ARIA2_RPC=http://127.0.0.1:6800/jsonrpc

# ---- optional: streaming tuning ----
STREAM_CONCURRENCY=4
STREAM_BUFFER_COUNT=8
STREAM_TIMEOUT_SEC=30
STREAM_MAX_RETRIES=3

# ---- optional: extra bot tokens for parallel downloads ----
# MULTI_TOKEN1=
# MULTI_TOKEN2=
